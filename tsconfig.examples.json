{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    "paths": {
      "@signalwire/sdk": ["./src/index.ts"],
      "@signalwire/sdk/livewire": ["./src/livewire/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "examples/**/*.ts",
    "rest/examples/**/*.ts",
    "relay/examples/**/*.ts",
    "livewire/examples/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
